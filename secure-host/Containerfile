# The secure-host image: the static secure-host binary and the BPF
# objects, nothing else, so that what sets the host up is exactly what the
# release's checksums name, and no agent code. Built by build.yml from its
# staged dist/ directory:
#
#   podman build --file secure-host/Containerfile dist
#
# and run by root podman with the host's root at /host
# (cgwalters-forge/actions's secure-host/docs/setup.md):
#
#   sudo podman run --rm --privileged --pid=host --network=none -v /:/host IMAGE@sha256:... CONFIG
#
# /agentic-job is the same binary by its old name, which the pinned
# action's `--entrypoint /agentic-job ... config --host` runs: for one
# release, until that action pins an image built so.
FROM scratch
LABEL org.opencontainers.image.source=https://github.com/cgwalters-forge/agentic-job
COPY --chmod=0755 secure-host-x86_64-unknown-linux-musl /secure-host
COPY --chmod=0755 secure-host-x86_64-unknown-linux-musl /agentic-job
COPY --chmod=0644 world_write.bpf.o /world_write.bpf.o
ENTRYPOINT ["/secure-host", "image"]
